# Copy to .env.local and fill in. Every key is optional:
# anything missing falls back to deterministic mock data so the app always runs.

# Qloo (request access via the hackathon developer guide form)
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# OpenAI — without it, a scripted planner runs the same tools instead
OPENAI_API_KEY=
# gpt-6-luna for development (cheapest); switch to gpt-6.1-sol for the demo
OPENAI_MODEL=gpt-6-luna
# low | medium | high — medium keeps a full tour plan to ~1–2 minutes
OPENAI_REASONING_EFFORT=medium

# Ticketmaster Discovery API (developer.ticketmaster.com)
TICKETMASTER_API_KEY=
